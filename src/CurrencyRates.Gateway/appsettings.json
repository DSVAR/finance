{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "finance": {
        "ClusterId": "finance",
        "Match": { "Path": "/api/finance/{**catch-all}" }
      }
    },
    "Clusters": {
      "users": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101" }
        }
      },
      "finance": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
